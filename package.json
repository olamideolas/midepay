{
  "name": "midepay",
  "version": "4.1.0",
  "description": "MidePay — Enterprise Nigerian Digital Wallet & Business Payment Platform",
  "main": "index.html",
  "scripts": {
    "build": "node build.js",
    "build:docs": "node scripts/build_sdlc_docx.js",
    "validate": "node scripts/validate_production.js",
    "test:runtime": "node scripts/test_e2e_runtime.js",
    "test:security": "node scripts/test_security_penetration.js",
    "test:webhooks": "node --experimental-strip-types scripts/test_payment_webhook.js",
    "test:database": "node scripts/test_v46_postgres_migration.mjs",
    "test:independent": "node scripts/test_independent_database.mjs && node scripts/test_independent_webhook.mjs",
    "test:phase1": "node scripts/test_phase1_security.mjs && node scripts/test_phase1_handlers.mjs",
    "test:sdk": "node scripts/test_browser_sdk.js",
    "test:staging": "node scripts/test_staging_preview.js",
    "test:payment-boundaries": "node scripts/test_payout_boundaries.mjs",
    "test:postgres-concurrency": "node scripts/test_native_postgres.mjs",
    "test:recovery": "node scripts/test_password_recovery.js",
    "test:paystack-pipeline": "node scripts/test_paystack_pipeline.mjs && node scripts/test_paystack_client.js",
    "test:reconciliation": "node scripts/test_payment_reconciliation.mjs",
    "test:operator-review": "node scripts/test_operator_payment_review.mjs",
    "test:accounting": "node scripts/test_accounting_boundaries.mjs",
    "test:provider-cases": "node scripts/test_provider_cases.mjs"
  },
  "keywords": [
    "fintech",
    "wallet",
    "nigeria",
    "supabase"
  ],
  "author": "MidePay",
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@supabase/supabase-js": "2.119.0",
    "nodemailer": "10.6.1",
    "pg": "8.16.3"
  }
}
